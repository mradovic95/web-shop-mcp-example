  {
    "name": "list_products",
    "title": "list_products",
    "description": "Search the web shop catalog. Takes three optional objects: filter (all fields optional, combined with AND), sort (list of {property, direction} in priority order, so each field can have its own direction; default id ASC) and pagination ({page, size}, default page 0, size 20, max size 100). The response includes content plus page, size, totalElements, totalPages, first and last; request further pages with pagination.page. Prices are in EUR.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "filter": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean",
              "description": "true = only active products, false = only inactive, omit for both"
            },
            "createdFrom": {
              "type": "string",
              "format": "date-time",
              "description": "Created at or after this ISO-8601 instant, e.g. 2026-01-01T00:00:00Z"
            },
            "createdTo": {
              "type": "string",
              "format": "date-time",
              "description": "Created at or before this ISO-8601 instant, e.g. 2026-12-31T23:59:59Z"
            },
            "maxPrice": {
              "type": "number",
              "description": "Maximum price in EUR (inclusive)"
            },
            "minPrice": {
              "type": "number",
              "description": "Minimum price in EUR (inclusive)"
            },
            "name": {
              "type": "string",
              "description": "Case-insensitive substring of the product name"
            },
            "query": {
              "type": "string",
              "description": "Free text, case-insensitive, matched against name or description"
            }
          },
          "description": "Filters, all optional and combined with AND"
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "ASC",
                  "DESC"
                ],
                "description": "ASC or DESC, default ASC"
              },
              "property": {
                "type": "string",
                "description": "Property to sort by"
              }
            },
            "required": [
              "property"
            ]
          },
          "description": "Sort orders in priority order, each with its own direction. property: one of id, name, price, active, createdAt, updatedAt. Default id ASC"
        },
        "pagination": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "format": "int32",
              "description": "Zero-based page index, default 0"
            },
            "size": {
              "type": "integer",
              "format": "int32",
              "description": "Page size 1-100, default 20"
            }
          },
          "description": "Zero-based page and page size (1-100). Default page 0, size 20"
        }
      },
      "required": []
    },
    "annotations": {
      "title": "",
      "readOnlyHint": true,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "update_product",
    "title": "update_product",
    "description": "Replace all fields of an existing product identified by id. Call get_product first to keep unchanged values.",
